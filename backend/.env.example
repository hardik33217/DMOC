# Database
DATABASE_URL="postgresql://user:password@localhost:5432/decisionos?schema=public"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Password Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_COOKIE_NAME="decisionos_session"
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE="lax"

# Email (optional - for password reset)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@decisionos.com"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"