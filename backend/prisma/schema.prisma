generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           String    @default("user")
  theme          String    @default("system")
  emailVerified  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  decisions      Decision[]
  auditEvents    AuditEvent[]
  importJobs     ImportJob[]
  sharesCreated  DecisionShare[] @relation("ShareCreatedBy")
  sharesReceived DecisionShare[] @relation("ShareRecipient")
  workflows      Workflow[]
  ownedBusinesses BusinessProfile[] @relation("BusinessOwner")
  businessMemberships BusinessMembership[]

  @@index([email])
  @@index([role])
}

model Decision {
  id          String           @id @default(uuid())
  ownerId     String
  businessId  String?
  title       String
  description String?
  category    String           @default("other")
  status      String           @default("draft")
  question    String
  deadline    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  business    BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  alternatives Alternative[]
  criteria    Criterion[]
  outcomes    Outcome[]
  scenarios   Scenario[]
  shares      DecisionShare[]
  reports     DecisionReport[]
  marketResearchFindings MarketResearchFinding[]

  @@index([ownerId])
  @@index([businessId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model Alternative {
  id          String    @id @default(uuid())
  decisionId  String
  title       String
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  decision    Decision    @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  outcomes    Outcome[]
  simulationResults SimulationResult[]

  @@index([decisionId])
  @@index([decisionId, order])
}

model Criterion {
  id          String    @id @default(uuid())
  decisionId  String
  name        String
  description String?
  weight      Float     @default(1)
  direction   String    @default("maximize")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  decision    Decision    @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([decisionId, order])
}

model Outcome {
  id              String    @id @default(uuid())
  alternativeId   String
  decisionId      String
  title           String
  description     String?
  probability     Float
  monetaryPayoff  Float?
  utilityScore    Float?
  riskLevel       String    @default("low")
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  alternative     Alternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  decision        Decision    @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([alternativeId])
  @@index([decisionId])
  @@index([alternativeId, order])
}

model Scenario {
  id                String    @id @default(uuid())
  decisionId        String
  name              String
  description       String?
  isBaseline        Boolean   @default(false)
  parentScenarioId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  decision          Decision    @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  parentScenario    Scenario?   @relation("ScenarioHierarchy", fields: [parentScenarioId], references: [id], onDelete: SetNull)
  childScenarios    Scenario[]  @relation("ScenarioHierarchy")
  inputs            ScenarioInput[]
  simulationRuns    SimulationRun[]

  @@index([decisionId])
  @@index([decisionId, isBaseline])
  @@index([parentScenarioId])
}

model ScenarioInput {
  id          String    @id @default(uuid())
  scenarioId  String
  entityType  String
  entityId    String
  field       String
  value       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  scenario    Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@unique([scenarioId, entityType, entityId, field])
}

model SimulationRun {
  id               String    @id @default(uuid())
  scenarioId       String
  algorithmVersion String
  inputSnapshot    String
  status           String    @default("pending")
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  scenario         Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  results          SimulationResult[]

  @@index([scenarioId])
  @@index([status])
  @@index([createdAt])
}

model SimulationResult {
  id                String   @id @default(uuid())
  simulationRunId   String
  alternativeId     String
  weightedScore     Float?
  expectedMonetaryValue Float?
  expectedUtility   Float?
  bestCase          Float?
  worstCase         Float?
  riskMetrics       String?
  sensitivityData   String?
  rank              Int?
  details           String?
  createdAt         DateTime @default(now())

  simulationRun     SimulationRun @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)
  alternative       Alternative   @relation(fields: [alternativeId], references: [id], onDelete: Cascade)

  @@index([simulationRunId])
  @@index([alternativeId])
  @@unique([simulationRunId, alternativeId])
}

model DecisionShare {
  id              String    @id @default(uuid())
  decisionId      String
  shareToken      String    @unique
  recipientEmail  String?
  accessLevel     String    @default("view")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String

  decision        Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  creator         User      @relation("ShareCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  recipient       User?     @relation("ShareRecipient", fields: [recipientEmail], references: [email], onDelete: SetNull)

  @@index([decisionId])
  @@index([shareToken])
  @@index([recipientEmail])
  @@index([expiresAt])
}

model AuditEvent {
  id          String    @id @default(uuid())
  actorId     String
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  actor       User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ImportJob {
  id                String    @id @default(uuid())
  ownerId           String
  fileName          String
  fileSize          Int
  status            String    @default("pending")
  validationSummary String?
  errorReport       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model Workflow {
  id          String    @id @default(uuid())
  ownerId     String
  businessId  String?
  title       String
  description String?
  version     Int       @default(1)
  status      String    @default("draft")
  isTemplate  Boolean   @default(false)
  templateId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  business    BusinessProfile?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  nodes       WorkflowNode[]
  edges       WorkflowEdge[]
  runs        WorkflowRun[]
  template    Workflow?         @relation("WorkflowTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  templates   Workflow[]        @relation("WorkflowTemplate")

  @@index([ownerId])
  @@index([businessId])
  @@index([isTemplate])
  @@index([templateId])
  @@index([updatedAt])
}

model WorkflowNode {
  id            String    @id @default(uuid())
  workflowId    String
  type          String
  title         String
  description   String?
  positionX     Float
  positionY     Float
  width         Float?
  height        Float?
  config        String
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workflow      Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceEdges   WorkflowEdge[] @relation("SourceNode")
  targetEdges   WorkflowEdge[] @relation("TargetNode")

  @@index([workflowId])
  @@index([type])
}

model WorkflowEdge {
  id            String    @id @default(uuid())
  workflowId    String
  sourceNodeId  String
  targetNodeId  String
  sourceHandle  String?
  targetHandle  String?
  label         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workflow      Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceNode    WorkflowNode  @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode    WorkflowNode  @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@unique([workflowId, sourceNodeId, targetNodeId, sourceHandle, targetHandle])
}

model WorkflowRun {
  id              String    @id @default(uuid())
  workflowId      String
  status          String    @default("pending")
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  inputSnapshot   String?
  outputSnapshot  String?

  workflow        Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeResults     WorkflowNodeResult[]

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
}

model WorkflowNodeResult {
  id            String    @id @default(uuid())
  runId         String
  nodeId        String
  status        String
  inputData     String?
  outputData    String?
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  createdAt     DateTime  @default(now())

  run           WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([nodeId])
}

model BusinessProfile {
  id             String    @id @default(uuid())
  ownerId        String
  name           String
  type           String    @default("retail") // retail, grocery, pharmacy, quick_commerce, wholesale, restaurant, service, startup, ecommerce, other
  status         String    @default("active") // active, sample, archived
  isExisting     Boolean   @default(true)
  country        String    @default("India")
  city           String?
  serviceArea    String?
  categories     String?   // JSON array of category names
  currency       String    @default("INR")
  currencySymbol String    @default("₹")
  taxName        String    @default("GST")
  taxRate        Float     @default(18.0)
  units          String?   // JSON array of units e.g. ["pcs", "packs", "kg", "boxes", "strips"]
  monthlyRevenue Float?
  monthlyCost    Float?
  hasExistingData Boolean  @default(false)
  learningMode   Boolean   @default(false)
  enterpriseMode Boolean   @default(false)
  isSample       Boolean   @default(false)
  settings       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner          User               @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships    BusinessMembership[]
  products       Product[]
  suppliers      Supplier[]
  salesRecords   SalesRecord[]
  purchaseOrders PurchaseOrder[]
  decisions      Decision[]
  reports        DecisionReport[]
  workflows      Workflow[]

  @@index([ownerId])
  @@index([type])
  @@index([status])
}

model BusinessMembership {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  role       String   @default("owner") // owner, manager, analyst, viewer
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Product {
  id                     String    @id @default(uuid())
  businessId             String
  name                   String
  brand                  String?
  barcode                String?
  sku                    String?
  category               String?
  unit                   String    @default("pcs")
  packSize               Int       @default(1)
  packUnit               String?
  purchasePrice          Float     @default(0)
  packPurchasePrice      Float?
  sellingPrice           Float     @default(0)
  taxRate                Float     @default(0)
  stockOnHand            Float     @default(0)
  reorderPoint           Float     @default(10)
  preferredStock         Float?
  batchNumber            String?
  expiryDate             DateTime?
  storageCondition       String?
  requiresPrescription   Boolean   @default(false)
  regulatoryStatus       String?
  sourceProvider         String?   // open_food_facts, nppa_pharmacy, manual, excel_import
  sourceUrl              String?
  sourceRetrievedAt      DateTime?
  verificationConfidence Float?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business               BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierQuotes         SupplierQuote[]
  stockMovements         StockMovement[]
  salesRecords           SalesRecord[]
  purchaseOrderItems     PurchaseOrderItem[]

  @@index([businessId])
  @@index([barcode])
  @@index([sku])
  @@index([category])
  @@index([expiryDate])
}

model Supplier {
  id                 String    @id @default(uuid())
  businessId         String
  name               String
  contactPerson      String?
  email              String?
  phone              String?
  address            String?
  paymentTerms       String?
  defaultLeadTimeDays Int      @default(3)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business           BusinessProfile   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quotes             SupplierQuote[]
  purchaseOrders     PurchaseOrder[]

  @@index([businessId])
  @@index([name])
}

model SupplierQuote {
  id               String    @id @default(uuid())
  supplierId       String
  productId        String
  quotedUnitCost   Float
  quotedPackCost   Float?
  minOrderQuantity Int       @default(1)
  leadTimeDays     Int       @default(3)
  isPreferred      Boolean   @default(false)
  validUntil       DateTime?
  createdAt        DateTime  @default(now())

  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([productId])
}

model StockMovement {
  id          String   @id @default(uuid())
  productId   String
  type        String   // purchase, sale, adjustment, waste_spoilage, return
  quantity    Float
  unitCost    Float?
  reason      String?
  referenceId String?
  performedBy String?
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model SalesRecord {
  id                     String    @id @default(uuid())
  businessId             String
  productId              String
  date                   DateTime  @default(now())
  quantitySold           Float
  unitPrice              Float
  totalAmount            Float
  wasStockoutSuppressed  Boolean   @default(false)
  channel                String    @default("in_store")
  createdAt              DateTime  @default(now())

  business               BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product                Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([date])
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  businessId           String
  supplierId           String
  orderNumber          String
  status               String    @default("draft") // draft, ordered, shipped, received, cancelled
  expectedDeliveryDate DateTime?
  totalAmount          Float     @default(0)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  business             BusinessProfile     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items                PurchaseOrderItem[]

  @@index([businessId])
  @@index([supplierId])
  @@index([orderNumber])
  @@index([status])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Float
  unitCost        Float
  totalCost       Float

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
}

model MarketResearchFinding {
  id                  String   @id @default(uuid())
  decisionId          String?
  productId           String?
  title               String
  factType            String   // product_info, official_price, competitor_price, supplier_quote, market_trend
  sourceName          String
  sourceUrl           String?
  retrievedAt         DateTime @default(now())
  geographicRelevance String?
  isVerified          Boolean  @default(false)
  confidenceScore     Float?
  content             String
  createdAt           DateTime @default(now())

  decision            Decision? @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([productId])
  @@index([factType])
}

model DecisionReport {
  id                  String   @id @default(uuid())
  businessId          String
  decisionId          String?
  title               String
  question            String
  recommendation      String   // proceed, do_not_proceed, alternative
  summaryText         String
  planningHorizonDays Int      @default(30)
  financialMetrics    String   // JSON string
  scenariosSnapshot   String   // JSON string
  assumptions         String   // JSON string
  missingInformation  String?  // JSON string
  createdBy           String?
  createdAt           DateTime @default(now())

  business            BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  decision            Decision?       @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([decisionId])
  @@index([createdAt])
}